# Base URL of the app under test.
# Points at exTransact running against its dedicated TEST Supabase project
# (started via `npm run dev:test` in exTransact, port 3001) — not the real
# dev instance on 3000, which uses the real Supabase project.
BASE_URL=http://localhost:3001

# Dedicated TEST Supabase project only — used by scripts/cleanupTestLoads.js
# to delete loads the suite creates (customer_name starting with "QA ").
# NEVER point these at the real/production Supabase project; the script
# also refuses to run against anything but the known test project ref.
SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme

# Local dev test accounts (Supabase Auth)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=changeme
TEST_DISPATCHER_ONE_EMAIL=dispatcher-one@example.com
TEST_DISPATCHER_ONE_PASSWORD=changeme
TEST_DISPATCHER_TWO_EMAIL=dispatcher-two@example.com
TEST_DISPATCHER_TWO_PASSWORD=changeme
